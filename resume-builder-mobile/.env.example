# ── Pocket Resume — Mobile (Expo) Environment Config ────────────────
#
# Copy this file to `.env` (gitignored). Variables prefixed with
# `EXPO_PUBLIC_` are inlined into the JS bundle at build time and are
# safe for client use only — never put secrets here.
#
# Read these in code via `process.env.EXPO_PUBLIC_API_BASE` or via
# `expo-constants` (see lib/api.ts).
#
# ── Development ──────────────────────────────────────────────────────
# Android emulator:  http://10.0.2.2:4001  (maps to host localhost)
# iOS simulator:     http://localhost:4001
# Physical device:   http://<your-lan-ip>:4001
EXPO_PUBLIC_API_BASE=http://10.0.2.2:4001
EXPO_PUBLIC_WEB_URL=http://localhost:4000

# ── Staging ──────────────────────────────────────────────────────────
# EXPO_PUBLIC_API_BASE=https://ats-rb-api-staging.onrender.com
# EXPO_PUBLIC_WEB_URL=https://ats-rb-web-staging.onrender.com

# ── Production ───────────────────────────────────────────────────────
# EXPO_PUBLIC_API_BASE=https://ats-rb-api.onrender.com
# EXPO_PUBLIC_WEB_URL=https://ats-rb-web.onrender.com

# ── Security (sideloaded distribution — see /SECURITY.md) ────────────
# Shared HMAC key for request signing. Must match REQUEST_SIGNING_KEY
# on the API. Leave blank to disable (signature header is omitted).
# Rotating this requires a new mobile build, which is the desired
# behaviour — old compromised builds become inert.
EXPO_PUBLIC_REQUEST_SIGNING_KEY=
