# ── ATS Resume Builder Mobile — Environment Config ───────────────────
#
# Copy this file to .env and update values for your environment.
#
# NOTE: React Native does not read .env files natively.
# Use react-native-config or expo-constants to load these values.
# Until then, API_BASE is set directly in lib/api.ts.
#
# ── Development ──────────────────────────────────────────────────────
# Android emulator:  http://10.0.2.2:4001  (maps to host localhost)
# iOS simulator:     http://localhost:4001
# Physical device:   http://<your-lan-ip>:4001
#
# ── Staging ──────────────────────────────────────────────────────────
# API_BASE=https://ats-rb-api-staging.onrender.com
#
# ── Production ───────────────────────────────────────────────────────
# API_BASE=https://api.your-domain.com

API_BASE=http://10.0.2.2:4001
