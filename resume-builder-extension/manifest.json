{
  "manifest_version": 3,
  "name": "CallbackCV — Job Hunt Companion",
  "version": "0.1.0",
  "description": "Capture job descriptions, auto-track applications with the resume version you used, and reach Sahaayak from any job board.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://*.naukri.com/*",
    "https://*.lever.co/*",
    "https://*.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://*.workable.com/*",
    "https://*.smartrecruiters.com/*",
    "https://ats-rb-api.onrender.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "CallbackCV",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.indeed.com/*",
        "https://*.naukri.com/job-listings*",
        "https://*.lever.co/*",
        "https://boards.greenhouse.io/*",
        "https://*.workable.com/*",
        "https://*.smartrecruiters.com/*"
      ],
      "js": ["content/job-board.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
