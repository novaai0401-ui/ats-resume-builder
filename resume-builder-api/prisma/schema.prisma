// Prisma schema for resume-builder-api
// Ref: https://www.prisma.io/docs

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  mobile       String?  @unique
  isAdmin      Boolean  @default(false)
  fullName     String
  passwordHash String
  refreshTokenHash String?
  refreshTokenExpiresAt DateTime?
  aiTokensUsed Int @default(0)
  aiTokensLimit Int @default(20000)
  atsScansUsed Int @default(0)
  atsScansLimit Int @default(10)
  resumesLimit Int @default(1)
  pdfExportsUsed Int @default(0)
  pdfExportsLimit Int @default(5)
  usagePeriodStart DateTime?
  usagePeriodEnd DateTime?
  plan          String @default("FREE")
  /// R-037: export-credit balance. Earned via referrals (1 per referred
  /// signup); consumed by PDF/DOCX export when the monthly quota is
  /// exhausted. Field pre-dates the feature (merge b0b259a) so it already
  /// exists in prod via the R-023 catch-up migration.
  premiumCredits Int @default(0)
  /// R-037: this user's shareable referral code. Generated on first
  /// access to GET /referrals/me, then stable forever.
  referralCode String? @unique
  /// R-031: outcome-nudge emails ("any reply from Acme?") are opt-out.
  /// The unsubscribe link in every nudge email flips this to false.
  nudgeEmailsEnabled Boolean @default(true)
  stripeCustomerId String?
  stripeSubscriptionId String?
  stripeCurrentPeriodEnd DateTime?
  loginCount   Int      @default(0)
  /// First auth method used by this account: password | google | github | linkedin | yahoo | email_otp
  primaryAuthProvider String @default("password")
  /// True once the user has explicitly set a password. Social signups get a
  /// random password hash on creation, so this flag distinguishes "real"
  /// passwords from placeholder ones.
  hasUserSetPassword Boolean @default(true)
  /// True if the user has saved a BYOK AI key locally — used for admin dashboard
  /// aggregate counting only. The actual key is never stored on the server.
  byokKeyEnabled Boolean @default(false)
  /// Brute-force protection for password login.
  failedLoginCount Int @default(0)
  lockedUntil DateTime?
  lastActiveAt DateTime?
  /// Phase 8 — consent for contributing anonymized resume PATTERNS (not
  /// personal details) to improve the parsing model. Default true: new
  /// users participate by default because the data we keep is PII-redacted
  /// patterns only (no names, emails, phones, URLs). A one-time notice
  /// in the UI explains this, and the user can toggle off in account
  /// settings at any time. Withdrawal stops new captures; existing
  /// samples are purged via a separate explicit action.
  trainingConsent Boolean @default(true)
  trainingConsentAt DateTime?
  /// Which version of the consent copy the user agreed to. Bumped whenever
  /// the wording of the consent surface materially changes so we can prove
  /// what each user actually agreed to. v1 = patterns-only, default-on.
  trainingConsentVersion Int @default(1)
  /// Whether the user has seen the one-time training-data notice modal.
  /// Used to surface the explanation exactly once per account.
  trainingConsentNoticeSeen Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resumes      Resume[]
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  title     String
  contact   Json?
  skills    String[]
  languages String[] @default([])
  templateId String?
  /// R-045 — design customization: font family id + density preset + accent.
  fontFamily String?
  density    String?
  accentColor String?
  /// R-045 Phase 2 — per-resume body-section order (ATS family). Empty = default.
  sectionOrder String[] @default([])
  /// R-045 Phase 3 — profile photo (base64 data URI; visual templates only).
  photoUrl   String?
  /// Set true when OUR AI (not the user's BYOK key) assisted this resume since
  /// its last paid download → a flat AI fee is added to the next download.
  aiAssistUsed Boolean @default(false)
  summary   String
  experience Json
  education  Json
  projects   Json?
  certifications Json?
  /// Standalone achievement statements (awards, recognitions, key wins).
  /// Plain string list like skills / languages.
  achievements String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model AppSetting {
  id                    String   @id @default(uuid())
  rateLimitEnabled      Boolean  @default(false)
  paymentFeatureEnabled Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model OtpChallenge {
  id          String   @id @default(uuid())
  mobile      String
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  lockedUntil DateTime?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([mobile])
}

model EmailOtpChallenge {
  id          String   @id @default(uuid())
  email       String
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  lockedUntil DateTime?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([email])
}

/// Password-reset OTP challenges. Separate from EmailOtpChallenge so the
/// (currently disabled) email-OTP login flow can never collide with reset
/// codes. Always responds enumeration-safe — never reveals if an account
/// exists when the OTP request is handled.
model PasswordResetChallenge {
  id          String   @id @default(uuid())
  email       String
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  lockedUntil DateTime?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([email])
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  email     String
  method    String   @default("email_otp")
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
}

model AiCritiqueLog {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PaymentHistory {
  id                String   @id @default(uuid())
  userId            String
  amountPaise       Int                                // Amount in smallest currency unit (paise for INR)
  currency          String   @default("INR")
  status            String   @default("pending")       // pending | captured | failed | refunded
  planType          String                             // STUDENT | PRO | DOWNLOAD
  paymentProvider   String   @default("razorpay")      // razorpay | stripe
  providerPaymentId String?                            // Razorpay payment_id or Stripe payment intent
  providerOrderId   String?                            // Razorpay order_id or Stripe session ID
  paymentMethod     String?                            // card | upi | netbanking | wallet
  receiptUrl        String?
  // R-073 recovery link: which resume this download paid for + the email
  // on file at purchase time, so support can look a payment up by email and
  // resend the resume. fulfilledAt is stamped once the resume has actually
  // been delivered (downloaded or emailed) so we can spot stranded payments.
  resumeId          String?                            // the resume a DOWNLOAD charge paid for
  email             String?                            // buyer email snapshot (support lookup key)
  fulfilledAt       DateTime?                          // set when the paid resume was delivered
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([providerOrderId])
  @@index([email])
  @@index([resumeId])
}

/// R-073: audit trail for every "here is your resume" email we send —
/// on a successful download and on a support/admin resend. Makes the
/// "a copy has been emailed to you" claim verifiable and gives support
/// proof of what was delivered to whom.
model ResumeEmailLog {
  id        String   @id @default(uuid())
  userId    String
  resumeId  String
  email     String
  kind      String   @default("download")   // download | admin_resend
  status    String                          // sent | failed | skipped
  error     String?                         // failure reason when status=failed
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([resumeId])
  @@index([email])
}

model AiTokenUsage {
  id           String   @id @default(uuid())
  userId       String
  featureType  String                                  // ats_scan | resume_critique | career_chat | gap_analysis etc.
  tokensUsed   Int
  modelUsed    String?                                 // groq-llama-3.3-70b, etc.
  costMicroCents Int?                                  // Cost tracking in micro-cents
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

/// Job Application Tracker: pipeline-style board for every role a user is
/// pursuing. Keeps JD text, company/role, stage, and notes together so the
/// resume tailored for that role can be linked back via resumeId.
model JobApplication {
  id           String   @id @default(uuid())
  userId       String
  company      String
  role         String
  jdUrl        String?
  jdText       String?
  location     String?
  salaryRange  String?
  /// wishlist | applied | phone_screen | interview | offer | rejected | withdrawn
  status       String   @default("wishlist")
  source       String?                                 // linkedin | referral | company-site | recruiter
  referral     String?                                 // name of referrer if applicable
  resumeId     String?                                 // linked tailored resume
  /// Which ResumeVersion of `resumeId` was used. The Outcome Loop reads this
  /// to attribute response/interview/offer rates back to a specific snapshot
  /// so users can see "v3 got 2.4× more replies than v1".
  resumeVersionId String?
  coverLetterId String?                                // linked tailored cover letter
  notes        String?
  nextActionAt DateTime?                               // follow-up / interview reminder
  appliedAt    DateTime?
  closedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, nextActionAt])
  // Outcome Loop (C-007): per-version outcome aggregation reads by
  // resumeVersionId. The index existed in migrations but was lost from
  // the schema during a merge — restored so prisma migrate diff stops
  // proposing to drop it.
  @@index([resumeVersionId])
}

/// Snapshot of a resume at a point in time. Lets users branch / restore
/// before risky AI rewrites and A/B-test multiple variants per role.
model ResumeVersion {
  id              String   @id @default(uuid())
  resumeId        String
  userId          String
  label           String?                                 // free-form e.g. "Pre-AI rewrite", "v2 senior pitch"
  snapshot        Json                                    // full resume payload at snapshot time
  atsScoreSnapshot Int?                                   // optional cached ATS score at snapshot time
  createdAt       DateTime @default(now())

  @@index([resumeId, createdAt])
  @@index([userId, createdAt])
}

/// R-032: audit row per inbound forwarded email. Bodies are NOT
/// stored — only the metadata needed to debug matching ("why didn't
/// my forwarded rejection get logged?") plus a truncated subject.
/// Rows expire after 30 days (cleaned by the same cron that runs
/// the outcome-nudge scan).
model InboundOutcomeMail {
  id                   String   @id @default(uuid())
  /// Null when the From address didn't match any account.
  userId               String?
  fromEmail            String
  /// Truncated to 140 chars.
  subject              String
  /// 'rejected' | 'interview' | 'offer' | null (nothing detected)
  detectedOutcome      String?
  /// 'applied' | 'disambiguation_sent' | 'no_match' | 'unknown_sender' | 'no_outcome'
  resolution           String
  matchedApplicationId String?
  createdAt            DateTime @default(now())
  expiresAt            DateTime

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// R-037: one row per successful referral. The anti-abuse contract
/// lives in the constraints:
///   - referredUserId unique → an account can only ever be referred once.
///   - emailHash unique      → the same email can't credit a referrer
///     twice even if the account is deleted and re-created.
///   - ipHash + createdAt    → the service caps credits per IP per
///     30 days (3) to stop one person farming credits from a single
///     machine with throwaway addresses.
/// creditGranted records whether the +1 actually landed (false when an
/// abuse rule suppressed it — we keep the row so repeat attempts stay
/// visible to the admin dashboard).
model Referral {
  id             String   @id @default(uuid())
  referrerUserId String
  referredUserId String   @unique
  emailHash      String   @unique
  ipHash         String?
  creditGranted  Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([referrerUserId, createdAt])
  @@index([ipHash, createdAt])
}

/// R-031: one outcome-nudge email per stale application. Each row is a
/// single-use signed token bundle: the email contains three one-tap
/// links (no_reply / rejected / interview) that all carry the same
/// token; tapping any of them advances the JobApplication status and
/// burns the token. Tokens expire after 30 days.
///
/// One row per (jobApplicationId) per nudge cycle — the scan skips
/// applications that already have an un-expired nudge so the user is
/// never double-mailed about the same application.
model OutcomeNudge {
  id               String    @id @default(uuid())
  userId           String
  jobApplicationId String
  /// URL-safe random token (32 chars). Single-use.
  token            String    @unique
  sentAt           DateTime  @default(now())
  expiresAt        DateTime
  usedAt           DateTime?
  /// 'no_reply' | 'rejected' | 'interview' — recorded on tap.
  actionTaken      String?

  @@index([jobApplicationId, sentAt])
  @@index([userId, sentAt])
}

/// Public portfolio / share link (R-038).
///
/// A ShareLink turns one of the user's saved resumes into an unguessable
/// public URL (`/p/:slug`). Recruiters can view it and download the PDF
/// without an account. Strictly opt-in — created only when the user
/// asks for it, revoked instantly (enabled=false → 404, no caching).
///
/// C-007: every link pins to a specific `resumeVersionId` so we can
/// attribute downstream outcomes ("someone in Bengaluru downloaded the
/// v3 snapshot last Tuesday") back to a versioned resume — the moat.
/// resumeVersionId is nullable for the case where the user hasn't taken
/// a snapshot yet; the link then resolves to the live resume body.
model ShareLink {
  id                  String   @id @default(uuid())
  /// Cryptographically random URL-safe slug. Unique. Length 12+ — short
  /// enough to be shareable, long enough to be unguessable (~71 bits).
  slug                String   @unique
  userId              String
  resumeId            String
  resumeVersionId     String?
  /// Soft-revoke. enabled=false → public endpoints return 404 immediately.
  /// We do not hard-delete so the visit log stays attached for audit.
  enabled             Boolean  @default(true)
  expiresAt           DateTime?
  /// Default false (DPDP-safe). Setting true emits `index,follow` on the
  /// public page; otherwise we emit `noindex,nofollow`.
  allowSearchIndexing Boolean  @default(false)
  /// If true, the public page replaces email + phone with a relay link
  /// (recruiter submits a message, the owner gets it via email).
  maskContact         Boolean  @default(false)
  /// Optional short headline shown above the resume on the public page
  /// (e.g. "Open to senior frontend roles in Bengaluru / remote").
  headline            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  /// Cached counters maintained on every event write so the owner's
  /// dashboard does not need a group-by per render.
  viewCount           Int      @default(0)
  downloadCount       Int      @default(0)
  lastVisitedAt       DateTime?

  @@index([userId])
  @@index([resumeId])
}

/// Single visit log row per view/download. Records what the dashboard
/// needs to surface ("3 views this week, 1 download from Bengaluru") AND
/// what feeds the Outcome Graph — but never raw PII about the visitor.
/// We store coarse geo (country / city when available), the User-Agent
/// truncated to 200 chars, and a SHA-256 of (slug + ip + ua) so we can
/// dedupe a single recruiter refreshing the page without storing the IP
/// in cleartext.
model ShareLinkEvent {
  id          String   @id @default(uuid())
  shareLinkId String
  /// 'view' | 'download'
  kind        String
  ipHash      String
  userAgent   String?
  country     String?
  city        String?
  referrer    String?
  createdAt   DateTime @default(now())

  @@index([shareLinkId, createdAt])
  @@index([shareLinkId, kind])
}

/// AI-generated cover letters. Kept separate from Resume so each JD can have
/// its own tailored letter without duplicating resume data. Body is markdown.
model CoverLetter {
  id           String   @id @default(uuid())
  userId       String
  resumeId     String?                                 // resume used as source material
  company      String
  role         String
  jdText       String?
  tone         String   @default("professional")       // professional | enthusiastic | concise | formal
  body         String                                  // markdown cover letter body
  wordCount    Int      @default(0)
  provider     String?                                 // groq | xai | fallback
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
}

/// PatternLearnerAgent — sample of a resume upload whose extraction confidence
/// fell below threshold. Captured anonymously (redacted raw text + verification
/// report + extracted snapshot) so the learner can propose new parsing rules.
model ParseFailureSample {
  id              String   @id @default(cuid())
  userId          String?
  fileName        String?
  /// Redacted raw text. Emails / phones / long digit runs replaced with tokens.
  redactedText    String
  /// VerificationReport JSON (confidence, issues[]).
  verification    Json
  /// What the parser produced (section keys + counts) — NOT the full resume.
  extractedShape  Json
  /// "low-confidence" | "user-flagged" | "missing-section"
  trigger         String   @default("low-confidence")
  /// open | proposed | promoted | rejected | duplicate
  status          String   @default("open")
  proposalId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
}

/// PatternLearnerAgent — a parsing pattern (regex or heuristic) proposed by the
/// LLM and optionally promoted to the live rule registry. Rules are DATA, not
/// code, so the field-mapper can hot-load them without redeploy.
model LearnedPattern {
  id              String   @id @default(cuid())
  /// What this pattern extracts. e.g. "experience.dateRange",
  /// "education.degree", "contact.phone", "section.heading"
  kind            String
  /// JS regex source (without flags) OR named heuristic id.
  pattern         String
  flags           String   @default("i")
  /// "regex" | "heuristic"
  patternType     String   @default("regex")
  /// Short human note from the LLM explaining why this pattern helps.
  rationale       String?
  /// Few-shot examples the LLM was given.
  examples        Json?
  /// Validator metrics: { precision, recall, sampleSize, regressionCount }
  metrics         Json?
  /// proposed | promoted | rejected | rolledback
  status          String   @default("proposed")
  sourceSampleId  String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([kind, status])
  @@index([status, createdAt])
}

/// Sahaayak — per-user opt-in profile + accumulated context the companion
/// uses to remember the user's journey across sessions. One row per user.
/// "Sahaayak" (सहायक) — a Sanskrit word for "companion / helper".
model SahaayakProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  /// User must opt in before any memory is recorded.
  optedIn         Boolean  @default(false)
  /// "witness" (default) | "coach" | "karmayoga" — controls tone.
  mode            String   @default("witness")
  /// Free-text preferences the user sets ("don't bring up my last layoff").
  guardrails      String?
  /// LLM-maintained running summary of facts worth remembering. Capped.
  summary         String?
  /// Last interaction timestamp, used for check-in cadence.
  lastInteractionAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Sahaayak — discrete events the user (or the system) logs. Used both to
/// drive pattern reframes ("3 fintech rejections this month") and to seed
/// the chat memory. Kept structured so we can analyze without LLM calls.
model SahaayakEvent {
  id          String   @id @default(cuid())
  userId      String
  /// rejection | interview | offer | layoff | win | mood | reflection
  kind        String
  /// Company / role / score / mood-rating / free-form. Schema varies by kind.
  payload     Json
  /// Optional short note from the user.
  note        String?
  /// 1..5 mood at time of event when the user supplies it.
  moodRating  Int?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, kind, occurredAt])
  @@index([userId, occurredAt])
}

/// Sahaayak — conversational turns. We keep the last N raw turns for
/// context; older content is folded into SahaayakProfile.summary by the
/// memory-summarizer.
model SahaayakMessage {
  id           String   @id @default(cuid())
  userId       String
  /// user | assistant | system
  role         String
  content      String
  /// Crisis flag set by the detector when the message contained despair
  /// language. We never delete these — they are the highest-signal moments.
  crisisFlag   Boolean  @default(false)
  /// Token estimate used for budgeting context windows.
  tokens       Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

/// Phase 8 — TrainingSample.
///
/// One row per resume upload that the contributing user has explicitly
/// consented to share for parser-model training. The raw text is PII-redacted
/// before persistence (same redactor as PatternLearner). The structured label
/// is populated in one of two ways:
///   1. AUTO from the final Resume payload after the user has confirmed
///      and edited the extraction in the editor (high signal — these are
///      "the user agreed this is correct" labels).
///   2. MANUAL via the admin labeling tool for samples where the auto
///      pathway never landed (uploads where the user abandoned the editor).
///
/// `splitGroup` is assigned at insert time (stratified by source format)
/// so train/val/test are stable across re-exports.
model TrainingSample {
  id                  String   @id @default(cuid())
  /// Nullable for synthetic / seed samples that aren't tied to a user.
  userId              String?
  /// Hashed device fingerprint or `null` — used for dedup across uploads
  /// without identifying the user beyond what `userId` already does.
  sourceFingerprint   String?
  sourceFileType      String   // pdf | docx | image | txt
  sourceFileBytes     Int      // size of the original file (for stats only)
  /// PII-redacted text from the upload. This is what the model trains on.
  redactedText        String
  /// Bounding boxes / layout signals if available (e.g. from pdf-parse +
  /// position metadata). Optional — text-only samples still train.
  layoutHints         Json?
  /// Gold-standard structured extraction. Null until labeled.
  structuredLabel     Json?
  /// auto | manual | seed — how the label was produced.
  labelSource         String?
  /// pending | labeled | reviewed | excluded
  status              String   @default("pending")
  /// Stable train/val/test split assigned at insert time.
  splitGroup          String   @default("train")
  /// Which consent version applies to this row.
  consentVersion      Int      @default(1)
  /// Free-form admin notes for label review.
  notes               String?
  labeledAt           DateTime?
  labeledBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, splitGroup])
  @@index([userId, createdAt])
  @@index([sourceFileType])
}

/// Phase 8 — ModelEvaluation. Snapshot of one model version's metrics
/// against a fixed evaluation slice of TrainingSample rows. Used to track
/// whether new training runs are actually improving on prior baselines.
model ModelEvaluation {
  id              String   @id @default(cuid())
  modelName       String   // e.g. "layoutlmv3-resume-v1"
  modelVersion    String   // e.g. "2026.01.15-r3"
  sampleCount     Int
  /// Per-field precision/recall/F1 plus overall: { contact: {p, r, f1}, ... }
  metrics         Json
  /// Free-form note about training run (commit, hyperparams, etc.)
  trainingNote    String?
  evaluatedAt     DateTime @default(now())

  @@index([modelName, evaluatedAt])
}

/// R-041 — B2B parsing API key (one row per tenant, possibly many
/// per organisation). Keys are 'pra_' (Pocket Resume API) + 32 chars
/// of base32-ish entropy; we store ONLY a SHA-256 hash — recovery
/// is impossible by design, the dashboard reissues if a key is lost.
/// `prefix` is the first 8 chars of the plaintext, kept so the
/// dashboard can show "pra_abc12def…" without storing the key.
/// `monthlyCallLimit` caps metered usage; ApiUsage rows feed the bill.
model ApiKey {
  id               String    @id @default(uuid())
  /// Display name set by the operator ("Acme Staffing — production").
  label            String
  /// SHA-256 of the plaintext key (hex).
  keyHash          String    @unique
  /// First 8 chars of the plaintext for UI ("pra_abc12def").
  prefix           String
  tenantSlug       String
  /// monthlyCallLimit=0 means UNLIMITED — we still record usage,
  /// the bill is computed from the count.
  monthlyCallLimit Int       @default(10000)
  /// Hard cap per minute regardless of plan — defends Chrome/AI from
  /// runaway scripts.
  perMinuteLimit   Int       @default(60)
  enabled          Boolean   @default(true)
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?

  @@index([tenantSlug])
}

/// R-041 — one row per public-API call (parse/score/tailor). Used to
/// compute monthly bills, surface abuse, and audit-trace tenant
/// activity. Truncated user-agent + ipHash only — never raw IPs.
model ApiUsage {
  id        String   @id @default(uuid())
  apiKeyId  String
  endpoint  String
  /// HTTP status returned. 2xx counted toward the bill; 4xx/5xx are
  /// surfaced in the dashboard but don't bill.
  status    Int
  ipHash    String?
  userAgent String?
  /// Round-trip wall time in milliseconds, for SLA reporting.
  durationMs Int     @default(0)
  createdAt DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([apiKeyId, status])
}

/// Persisted snapshots of the self-learning resume-pattern-model
/// (packages/resume-pattern-model), trained from the PII-redacted
/// TrainingSample / ParseFailureSample corpus. The newest snapshot is
/// what the library ships with; older rows are an audit trail.
model PatternModelSnapshot {
  id        String   @id @default(cuid())
  /// Number of corpus documents the model had seen at snapshot time.
  docsSeen  Int
  /// Vocabulary size + header-shape count for quick dashboard stats.
  vocabSize Int      @default(0)
  shapes    Int      @default(0)
  /// The serialized model (ResumePatternModel.toJSON()).
  model     Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Saved job-search alert: we re-run the Adzuna search on a cron and email
/// the user when NEW openings appear that they haven't been shown before.
model JobAlert {
  id           String    @id @default(cuid())
  userId       String
  query        String
  location     String?
  active       Boolean   @default(true)
  /// Job keys (URLs) already emailed — dedupe across runs.
  seenKeys     Json      @default("[]")
  lastRunAt    DateTime?
  lastMatchAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([active])
}
