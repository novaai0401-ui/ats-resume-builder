// Prisma schema for resume-builder-api
// Ref: https://www.prisma.io/docs

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  mobile       String?  @unique
  isAdmin      Boolean  @default(false)
  fullName     String
  passwordHash String
  refreshTokenHash String?
  refreshTokenExpiresAt DateTime?
  aiTokensUsed Int @default(0)
  aiTokensLimit Int @default(20000)
  atsScansUsed Int @default(0)
  atsScansLimit Int @default(10)
  resumesLimit Int @default(1)
  pdfExportsUsed Int @default(0)
  pdfExportsLimit Int @default(5)
  usagePeriodStart DateTime?
  usagePeriodEnd DateTime?
  plan          String @default("FREE")
  premiumCredits Int @default(0)
  stripeCustomerId String?
  stripeSubscriptionId String?
  stripeCurrentPeriodEnd DateTime?
  loginCount   Int      @default(0)
  /// First auth method used by this account: password | google | github | linkedin | yahoo | email_otp
  primaryAuthProvider String @default("password")
  /// True once the user has explicitly set a password. Social signups get a
  /// random password hash on creation, so this flag distinguishes "real"
  /// passwords from placeholder ones.
  hasUserSetPassword Boolean @default(true)
  /// True if the user has saved a BYOK AI key locally — used for admin dashboard
  /// aggregate counting only. The actual key is never stored on the server.
  byokKeyEnabled Boolean @default(false)
  /// Brute-force protection for password login.
  failedLoginCount Int @default(0)
  lockedUntil DateTime?
  lastActiveAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resumes      Resume[]
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  title     String
  contact   Json?
  skills    String[]
  languages String[] @default([])
  templateId String?
  summary   String
  experience Json
  education  Json
  projects   Json?
  certifications Json?

  // ---------------------------------------------------------------------------
  // Phase 7 — zero-knowledge encrypted payload columns. When `ciphertext` is
  // set, the plaintext columns above are deprecated for this row and should
  // be considered untrusted (they get nulled-out once migration is complete).
  // The server never holds the data-encryption key; it only stores wrapped
  // blobs that the client decrypts after unlocking the vault.
  // ---------------------------------------------------------------------------
  /// AES-GCM ciphertext of the full resume payload (base64url).
  ciphertext String?
  /// AES-GCM IV used with `ciphertext` (base64url).
  iv         String?
  /// AES-GCM ciphertext of the title (base64url). Title encrypted separately
  /// so list views can decrypt only what they render.
  titleCipher String?
  /// AES-GCM IV used with `titleCipher` (base64url).
  titleIv    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model AppSetting {
  id                    String   @id @default(uuid())
  rateLimitEnabled      Boolean  @default(false)
  paymentFeatureEnabled Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model OtpChallenge {
  id          String   @id @default(uuid())
  mobile      String
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  lockedUntil DateTime?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([mobile])
}

model EmailOtpChallenge {
  id          String   @id @default(uuid())
  email       String
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  lockedUntil DateTime?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([email])
}

/// Password-reset OTP challenges. Separate from EmailOtpChallenge so the
/// (currently disabled) email-OTP login flow can never collide with reset
/// codes. Always responds enumeration-safe — never reveals if an account
/// exists when the OTP request is handled.
model PasswordResetChallenge {
  id          String   @id @default(uuid())
  email       String
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  lockedUntil DateTime?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([email])
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  email     String
  method    String   @default("email_otp")
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
}

model AiCritiqueLog {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PaymentHistory {
  id                String   @id @default(uuid())
  userId            String
  amountPaise       Int                                // Amount in smallest currency unit (paise for INR)
  currency          String   @default("INR")
  status            String   @default("pending")       // pending | captured | failed | refunded
  planType          String                             // STUDENT | PRO
  paymentProvider   String   @default("razorpay")      // razorpay | stripe
  providerPaymentId String?                            // Razorpay payment_id or Stripe payment intent
  providerOrderId   String?                            // Razorpay order_id or Stripe session ID
  paymentMethod     String?                            // card | upi | netbanking | wallet
  receiptUrl        String?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([providerOrderId])
}

model AiTokenUsage {
  id           String   @id @default(uuid())
  userId       String
  featureType  String                                  // ats_scan | resume_critique | career_chat | gap_analysis etc.
  tokensUsed   Int
  modelUsed    String?                                 // groq-llama-3.3-70b, etc.
  costMicroCents Int?                                  // Cost tracking in micro-cents
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

/// Job Application Tracker: pipeline-style board for every role a user is
/// pursuing. Keeps JD text, company/role, stage, and notes together so the
/// resume tailored for that role can be linked back via resumeId.
model JobApplication {
  id           String   @id @default(uuid())
  userId       String
  company      String
  role         String
  jdUrl        String?
  jdText       String?
  location     String?
  salaryRange  String?
  /// wishlist | applied | phone_screen | interview | offer | rejected | withdrawn
  status       String   @default("wishlist")
  source       String?                                 // linkedin | referral | company-site | recruiter
  referral     String?                                 // name of referrer if applicable
  resumeId     String?                                 // linked tailored resume
  /// Which ResumeVersion of `resumeId` was used. The Outcome Loop reads this
  /// to attribute response/interview/offer rates back to a specific snapshot
  /// so users can see "v3 got 2.4× more replies than v1".
  resumeVersionId String?
  coverLetterId String?                                // linked tailored cover letter
  notes        String?
  nextActionAt DateTime?                               // follow-up / interview reminder
  appliedAt    DateTime?
  closedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, nextActionAt])
}

/// Snapshot of a resume at a point in time. Lets users branch / restore
/// before risky AI rewrites and A/B-test multiple variants per role.
model ResumeVersion {
  id              String   @id @default(uuid())
  resumeId        String
  userId          String
  label           String?                                 // free-form e.g. "Pre-AI rewrite", "v2 senior pitch"
  snapshot        Json                                    // full resume payload at snapshot time
  atsScoreSnapshot Int?                                   // optional cached ATS score at snapshot time
  createdAt       DateTime @default(now())

  @@index([resumeId, createdAt])
  @@index([userId, createdAt])
}

/// AI-generated cover letters. Kept separate from Resume so each JD can have
/// its own tailored letter without duplicating resume data. Body is markdown.
model CoverLetter {
  id           String   @id @default(uuid())
  userId       String
  resumeId     String?                                 // resume used as source material
  company      String
  role         String
  jdText       String?
  tone         String   @default("professional")       // professional | enthusiastic | concise | formal
  body         String                                  // markdown cover letter body
  wordCount    Int      @default(0)
  provider     String?                                 // groq | xai | fallback
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
}

/// PatternLearnerAgent — sample of a resume upload whose extraction confidence
/// fell below threshold. Captured anonymously (redacted raw text + verification
/// report + extracted snapshot) so the learner can propose new parsing rules.
model ParseFailureSample {
  id              String   @id @default(cuid())
  userId          String?
  fileName        String?
  /// Redacted raw text. Emails / phones / long digit runs replaced with tokens.
  redactedText    String
  /// VerificationReport JSON (confidence, issues[]).
  verification    Json
  /// What the parser produced (section keys + counts) — NOT the full resume.
  extractedShape  Json
  /// "low-confidence" | "user-flagged" | "missing-section"
  trigger         String   @default("low-confidence")
  /// open | proposed | promoted | rejected | duplicate
  status          String   @default("open")
  proposalId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
}

/// PatternLearnerAgent — a parsing pattern (regex or heuristic) proposed by the
/// LLM and optionally promoted to the live rule registry. Rules are DATA, not
/// code, so the field-mapper can hot-load them without redeploy.
model LearnedPattern {
  id              String   @id @default(cuid())
  /// What this pattern extracts. e.g. "experience.dateRange",
  /// "education.degree", "contact.phone", "section.heading"
  kind            String
  /// JS regex source (without flags) OR named heuristic id.
  pattern         String
  flags           String   @default("i")
  /// "regex" | "heuristic"
  patternType     String   @default("regex")
  /// Short human note from the LLM explaining why this pattern helps.
  rationale       String?
  /// Few-shot examples the LLM was given.
  examples        Json?
  /// Validator metrics: { precision, recall, sampleSize, regressionCount }
  metrics         Json?
  /// proposed | promoted | rejected | rolledback
  status          String   @default("proposed")
  sourceSampleId  String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([kind, status])
  @@index([status, createdAt])
}

/// Sahaayak — per-user opt-in profile + accumulated context the companion
/// uses to remember the user's journey across sessions. One row per user.
/// "Sahaayak" (सहायक) — a Sanskrit word for "companion / helper".
model SahaayakProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  /// User must opt in before any memory is recorded.
  optedIn         Boolean  @default(false)
  /// "witness" (default) | "coach" | "karmayoga" — controls tone.
  mode            String   @default("witness")
  /// Free-text preferences the user sets ("don't bring up my last layoff").
  guardrails      String?
  /// LLM-maintained running summary of facts worth remembering. Capped.
  summary         String?
  /// Last interaction timestamp, used for check-in cadence.
  lastInteractionAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Sahaayak — discrete events the user (or the system) logs. Used both to
/// drive pattern reframes ("3 fintech rejections this month") and to seed
/// the chat memory. Kept structured so we can analyze without LLM calls.
model SahaayakEvent {
  id          String   @id @default(cuid())
  userId      String
  /// rejection | interview | offer | layoff | win | mood | reflection
  kind        String
  /// Company / role / score / mood-rating / free-form. Schema varies by kind.
  payload     Json
  /// Optional short note from the user.
  note        String?
  /// 1..5 mood at time of event when the user supplies it.
  moodRating  Int?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, kind, occurredAt])
  @@index([userId, occurredAt])
}

/// Sahaayak — conversational turns. We keep the last N raw turns for
/// context; older content is folded into SahaayakProfile.summary by the
/// memory-summarizer.
model SahaayakMessage {
  id           String   @id @default(cuid())
  userId       String
  /// user | assistant | system
  role         String
  content      String
  /// Crisis flag set by the detector when the message contained despair
  /// language. We never delete these — they are the highest-signal moments.
  crisisFlag   Boolean  @default(false)
  /// Token estimate used for budgeting context windows.
  tokens       Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

/// UserVault — public-side material for the zero-knowledge encrypted
/// resume sync. Holds NO secrets: the wrapped data-encryption key
/// cannot be unwrapped without the user's passphrase OR recovery code,
/// neither of which the server ever sees in raw form.
///
/// One row per user. Schema-versioned so future KDF/cipher upgrades
/// can land without breaking old vaults.
model UserVault {
  id              String   @id @default(cuid())
  userId          String   @unique
  schemaVersion   Int      @default(1)
  /// JSON: { algo: "PBKDF2", hash: "SHA-256", iterations: number }
  kdfParams       Json
  /// base64url salt for the passphrase KDF
  passphraseSalt  String
  /// base64url salt for the recovery-code KDF
  recoverySalt    String
  /// DEK wrapped by the passphrase-derived KEK: { iv, ciphertext } base64url
  passphraseWrap  Json
  /// DEK wrapped by the recovery-code-derived KEK: { iv, ciphertext } base64url
  recoveryWrap    Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
