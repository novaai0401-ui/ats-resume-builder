// Prisma schema for resume-builder-api
// Ref: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  mobile       String?  @unique
  isAdmin      Boolean  @default(false)
  fullName     String
  passwordHash String
  refreshTokenHash String?
  refreshTokenExpiresAt DateTime?
  aiTokensUsed Int @default(0)
  aiTokensLimit Int @default(20000)
  atsScansUsed Int @default(0)
  atsScansLimit Int @default(10)
  resumesLimit Int @default(1)
  pdfExportsUsed Int @default(0)
  pdfExportsLimit Int @default(5)
  usagePeriodStart DateTime?
  usagePeriodEnd DateTime?
  plan          String @default("FREE")
  premiumCredits Int @default(0)
  stripeCustomerId String?
  stripeSubscriptionId String?
  stripeCurrentPeriodEnd DateTime?
  loginCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resumes      Resume[]
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  title     String
  contact   Json?
  skills    String[]
  languages String[] @default([])
  templateId String?
  summary   String
  experience Json
  education  Json
  projects   Json?
  certifications Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model AppSetting {
  id                    String   @id @default(uuid())
  rateLimitEnabled      Boolean  @default(false)
  paymentFeatureEnabled Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model OtpChallenge {
  id          String   @id @default(uuid())
  mobile      String
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  lockedUntil DateTime?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([mobile])
}

model EmailOtpChallenge {
  id          String   @id @default(uuid())
  email       String
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  lockedUntil DateTime?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([email])
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  email     String
  method    String   @default("email_otp")
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
}

model AiCritiqueLog {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
