# Core
PORT=4001
NODE_ENV=development
CORS_ORIGIN=http://localhost:4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_builder?schema=public
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT_SECONDS=30
PRISMA_CONNECT_TIMEOUT_SECONDS=10

# Auth
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
OTP_SESSION_EXPIRES_IN=30m
SMS_PROVIDER=dev
OTP_SEND_LIMIT_PER_PHONE_PER_HOUR=5
OTP_SEND_LIMIT_PER_IP_PER_HOUR=20
OTP_VERIFY_LIMIT_PER_PHONE_PER_HOUR=20

# ─── Social login removed ────────────────────────────────────────────────
# We no longer integrate Google/LinkedIn/Yahoo/GitHub OAuth. Users register
# and log in with email + password (registration verifies the email via
# OTP). If you previously had these env vars set, you can delete them on
# Render — nothing in the running code reads them anymore.

# ─── Email / SMTP (required for OTP delivery) ─────────────────────────────
# Configure ANY SMTP provider below. OTP emails can be delivered to
# any valid email address (Gmail, Outlook, Yahoo, corporate, etc.)
# as long as the sender SMTP account is properly configured.
#
# ── Gmail SMTP ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd-efgh-ijkl-mnop        (use App Password, not account password)
# SMTP_FROM=ATS Resume Builder <you@gmail.com>
# Note: Enable 2FA then create App Password at https://myaccount.google.com/apppasswords
#
# ── Outlook / Microsoft 365 SMTP ──
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@outlook.com
# SMTP_PASS=your-password
# SMTP_FROM=ATS Resume Builder <you@outlook.com>
#
# ── Zoho SMTP ──
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@zoho.com
# SMTP_PASS=your-password
# SMTP_FROM=ATS Resume Builder <you@zoho.com>
#
# ── Amazon SES SMTP ──
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-ses-smtp-user
# SMTP_PASS=your-ses-smtp-password
# SMTP_FROM=ATS Resume Builder <verified@yourdomain.com>
#
# ── SendGrid SMTP ──
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key
# SMTP_FROM=ATS Resume Builder <you@yourdomain.com>
#
# ── Custom / Corporate SMTP ──
# SMTP_HOST=mail.yourcompany.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@yourcompany.com
# SMTP_PASS=your-password
# SMTP_FROM=ATS Resume Builder <noreply@yourcompany.com>
#
# Active configuration (replace with your real values):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=ATS Resume Builder <your-email@gmail.com>
SMTP_SECURE=false
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000

SMS_GATEWAY_URL=http://localhost:7071
GSM_MODEM_ENABLED=false
GSM_MODEM_COMMAND=

# AI service (legacy — used by existing parse-jd, critique, skill-gap endpoints)
AI_SERVICE_URL=http://localhost:7001

# AI Provider for AI-powered critique (default: groq)
# Options: groq, xai
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# XAI_API_KEY=
# XAI_MODEL=grok-3-mini-fast
AI_TIMEOUT_MS=30000
AI_FREE_MAX_REQUESTS_PER_DAY=10

# Stripe (Global - USD pricing)
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_PRICE_STUDENT=price_student_id
STRIPE_PRICE_PRO=price_pro_id
STRIPE_SUCCESS_URL=http://localhost:4000/dashboard
STRIPE_CANCEL_URL=http://localhost:4000/dashboard

# Stripe (India - INR pricing, optional)
# Create separate INR price IDs in Stripe for Indian users
# Student: ₹199/mo + 18% GST = ₹235/mo
# Pro: ₹499/mo + 18% GST = ₹589/mo
STRIPE_PRICE_STUDENT_INR=
STRIPE_PRICE_PRO_INR=

# Razorpay (India payments — UPI, cards, netbanking, wallets)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# Optional: override plan prices in paise (default: ₹419/mo Student, ₹839/mo Pro)
# RAZORPAY_PRICE_STUDENT_MONTHLY=41900
# RAZORPAY_PRICE_PRO_MONTHLY=83900
# RAZORPAY_PRICE_STUDENT_ANNUAL=419000
# RAZORPAY_PRICE_PRO_ANNUAL=839000
# RAZORPAY_CURRENCY=INR

# ─── Per-download charge (optional, off by default) ──────────────────────
# When enabled, each PDF download requires a one-time payment:
#   • India (region=IN): Razorpay INR ₹49 (configurable via DOWNLOAD_CHARGE_INR_PAISE)
#   • Rest of world: Stripe Checkout USD $0.99 (via DOWNLOAD_CHARGE_USD_CENTS)
# The client must also set NEXT_PUBLIC_ENABLE_DOWNLOAD_CHARGE=true.
ENABLE_DOWNLOAD_CHARGE=false
DOWNLOAD_CHARGE_INR_PAISE=4900
DOWNLOAD_CHARGE_USD_CENTS=99
# Stripe Checkout return URLs (must be absolute https URLs in prod)
DOWNLOAD_CHARGE_SUCCESS_URL=http://localhost:4000/billing/download-success
DOWNLOAD_CHARGE_CANCEL_URL=http://localhost:4000/resume

# Admin settings access
ADMIN_EMAILS=novaai0401@gmail.com
ADMIN_USER_IDS=
ADMIN_MOBILES=+919307009427

# ─── Admin bootstrap (item 12) ───────────────────────────────────────────
# Set ADMIN_BOOTSTRAP_PASSWORD to a real, long secret in your deployed env.
# The API hashes it with bcrypt on every boot — plaintext is never stored.
# If the user already exists, the password is only overwritten when
# ADMIN_BOOTSTRAP_FORCE_RESET=true.
ADMIN_BOOTSTRAP_EMAIL=novaai0401@gmail.com
ADMIN_BOOTSTRAP_MOBILE=+919307009427
ADMIN_BOOTSTRAP_NAME=Platform Admin
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FORCE_RESET=false

# ─── Security hardening ──────────────────────────────────────────────────
# HIBP breached-password check on register + change-password. Disable only
# if your deployment cannot reach api.pwnedpasswords.com.
ENABLE_HIBP_CHECK=true

# Resume creation rate-limit feature rollout
RESUME_CREATION_RATE_LIMIT_DEFAULT=false
FORCE_DISABLE_RATE_LIMIT=true

# PDF export — Chrome/Chromium path for Puppeteer (auto-detected if not set)
# CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# PDF renderer resilience (R-074). One shared Chromium is reused across
# requests; these bound concurrency + latency so exports can't OOM or hang
# the box. Defaults shown; raise concurrency only with more memory.
# PDF_MAX_CONCURRENCY=2          # max Chromium pages rendering at once
# PDF_SETCONTENT_TIMEOUT_MS=20000  # ceiling for loading HTML into the page
# PDF_RENDER_TIMEOUT_MS=20000      # ceiling for the actual PDF print
# PDF_QUEUE_TIMEOUT_MS=25000       # max wait for a free render slot (else 503)

# ── Sideloaded mobile distribution (see SECURITY.md) ───────────────────
# 64-char hex secret shared with the mobile build at compile time.
# When set, every request from a mobile client must carry a valid
# X-Request-Signature header, otherwise it's rejected. Leave blank to
# disable (signature middleware no-ops). Generate with:
#   openssl rand -hex 32
REQUEST_SIGNING_KEY=

# Release manifest served at GET /app/version. Update after every EAS
# build so /download displays the right hash and the running app's
# update-checker can find the new version.
APP_LATEST_VERSION=1.0.0
APP_MIN_SUPPORTED_VERSION=1.0.0
APP_FORCE_UPGRADE=false
APP_RELEASED_AT=
APP_RELEASE_NOTES=
APP_ANDROID_DOWNLOAD_URL=
APP_ANDROID_SHA256=
APP_ANDROID_SIGNATURE_SHA256=
APP_ANDROID_SIZE_BYTES=
APP_IOS_TESTFLIGHT_URL=
APP_WEB_URL=https://pocketresume.app

# ── Sign in with LinkedIn (OpenID Connect) ──────────────────────────
# LinkedIn-only social login. Create an app at https://www.linkedin.com/developers/
# with the "Sign In with LinkedIn using OpenID Connect" product enabled, then set
# the Authorized redirect URL to LINKEDIN_REDIRECT_URI below.
# Leave these blank to keep social login disabled (the button auto-hides).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.pocketresume.app/auth/linkedin/callback
# Optional dedicated secret for signing the OAuth CSRF state (falls back to JWT_SECRET).
OAUTH_STATE_SECRET=

# ── Live job openings (Adzuna) ──────────────────────────────────────
# Powers real openings in the Skill-Demand Agent + GET /ai/live-openings
# (Student/Pro). Free tier: register at https://developer.adzuna.com/ to get
# an app id + key. Leave blank to fall back to curated company suggestions.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ISO country for listings: in (India), us, gb, etc.
ADZUNA_COUNTRY=in
# Optional default location filter (e.g. "Bengaluru"); blank = nationwide.
ADZUNA_DEFAULT_LOCATION=

# ─── Audit / analytics dashboard ─────────────────────────────────────────────
# Self-hosted audit-admin-analytics sink. Every /auth event (login, register,
# logout, login_failed) is forwarded server-side so web + mobile + extension
# all show up in one dashboard. Leave both blank to disable cleanly — the
# AnalyticsService no-ops if either is missing and auth keeps working.
#
# The dashboard derives IP / device / OS / browser / geo from the incoming
# request headers; we forward the end user's real x-forwarded-for and
# user-agent on the outgoing fetch so events tag the user, not this server.
AUDIT_URL=https://katha-insights.onrender.com/dashboard
# 32-char write key from dashboard → Projects → "ATS Resume API".
AUDIT_WRITE_KEY=

# ── Mail debugging ──
# When true, the forgot-password 503 response includes the REAL (sanitized)
# SMTP error so you can read it in the browser Network tab instead of an
# admin token / logs. Turn ON temporarily to diagnose, then set back to false.
# MAIL_DEBUG_ERRORS=false

# ── Error tracking (Sentry) — OPT-IN, fully no-op when SENTRY_DSN unset ──
# Set to your Sentry project DSN to get alerted when payments/exports/DB
# throw in prod. Leave blank and the app behaves exactly as before.
SENTRY_DSN=
# Perf tracing sample rate (0 = off, default). Only raise if you want traces.
# SENTRY_TRACES_SAMPLE_RATE=0
# Optional release tag (e.g. git SHA) so errors group by deploy.
# SENTRY_RELEASE=
# Send request bodies/headers (may contain PII). Default false.
# SENTRY_SEND_PII=false

# ─── Export quota enforcement (R-003) ────────────────────────────────────────
# Monthly PDF + DOCX export cap (5 FREE / 25 Student / 200 Pro) is ENFORCED
# by default. The only supported way to turn it off is to set
# ENFORCE_EXPORT_QUOTA=false — used during pre-launch testing so the founder
# can pull more than 5 PDFs from the single test account without blocking
# their own QA. Remove this line (or set to true) before going live; R-022
# launch-checklist enforces that.
#
# Per-minute burst rate-limit (8/min) stays on regardless to keep Chrome safe.
ENFORCE_EXPORT_QUOTA=true

# ─── Outcome nudges (R-031) ──────────────────────────────────────────────────
# Daily scan that emails users about stale applications ("any reply from
# Acme? [No reply] [Rejected] [Interview!]"). Trigger via Render Cron Job:
#   curl -X POST $API_URL/outcome-nudge/run -H "x-cron-secret: $CRON_SECRET"
# The endpoint refuses to run when CRON_SECRET is unset. One nudge per
# application per 30 days; unsubscribe honoured globally per user.
CRON_SECRET=

# ─── Mail-in outcome capture (R-032) ─────────────────────────────────────────
# Users forward rejection / interview / offer emails to
# track@pocketresume.app. Point your inbound-mail provider (SendGrid
# Inbound Parse, Mailgun Routes, Cloudflare Email Workers) at:
#   POST $API_URL/outcome-mail/inbound?secret=$INBOUND_MAIL_SECRET
# The endpoint refuses to run when the secret is unset. Email bodies are
# never stored; audit rows keep from + truncated subject for 30 days.
INBOUND_MAIL_SECRET=
# Public API origin used in the one-tap links inside disambiguation
# emails (falls back to localhost in dev).
API_PUBLIC_URL=

# ─── Public B2B API (R-041) ──────────────────────────────────────────────────
# Tenant keys are issued via POST /admin/api-keys (admin-only). No env vars
# control the public surface itself — every key carries its own monthly +
# per-minute caps. The /v1 routes are open to any holder of a valid key;
# usage is logged to ApiUsage for billing.
