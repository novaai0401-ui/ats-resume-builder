# ═══════════════════════════════════════════════════════════════════════
# ATS Resume Builder API — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in real values.
#
# ⚠  PRODUCTION: The app will refuse to start if critical secrets are
#    missing or still set to placeholder values. See src/env-validation.ts.
# ═══════════════════════════════════════════════════════════════════════

# ─── Core ──────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Comma-separated allowed origins for CORS (required in production)
CORS_ORIGIN=http://localhost:3000

# ─── Database (Supabase Postgres) ─────────────────────────────────────
# Production: use your Supabase pooler connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_builder?schema=public
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT_SECONDS=30
PRISMA_CONNECT_TIMEOUT_SECONDS=10

# ─── Auth / JWT ────────────────────────────────────────────────────────
# IMPORTANT: In production these MUST be strong random secrets (>= 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── Token Encryption ─────────────────────────────────────────────────
# 32-byte key in hex (64 hex chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# ─── Redis / Upstash ──────────────────────────────────────────────────
# Required in production for OAuth state, session handoff, rate limiting.
# In development, falls back to in-memory store.
REDIS_URL=https://YOUR-UPSTASH-URL.upstash.io
REDIS_TOKEN=YOUR_UPSTASH_TOKEN

# ─── OTP ───────────────────────────────────────────────────────────────
OTP_SESSION_EXPIRES_IN=30m
SMS_PROVIDER=dev
OTP_SEND_LIMIT_PER_PHONE_PER_HOUR=5
OTP_SEND_LIMIT_PER_IP_PER_HOUR=20
OTP_VERIFY_LIMIT_PER_PHONE_PER_HOUR=20

# ─── Twilio (optional — SMS OTP) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_HTTP_TIMEOUT_MS=10000

# ─── Google Drive OAuth (file import) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:3000/dashboard
DRIVE_SESSION_TTL_MS=1800000
DRIVE_OAUTH_STATE_TTL_MS=600000

# ─── Social Login (Google/LinkedIn/Yahoo/GitHub) ──────────────────────
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3001/auth/social/google/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/auth/social/linkedin/callback

YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:3001/auth/social/yahoo/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/auth/social/github/callback

# Frontend URL where OAuth callbacks redirect (with handoff token)
SOCIAL_LOGIN_SUCCESS_URL=http://localhost:3000/auth/callback

# ─── Email / SMTP (required for email OTP) ────────────────────────────
# Gmail: use App Password (not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=ATS Resume Builder <your-email@gmail.com>
SMTP_SECURE=false

# ─── SMS Gateway ──────────────────────────────────────────────────────
SMS_GATEWAY_URL=http://localhost:7071
GSM_MODEM_ENABLED=false
GSM_MODEM_COMMAND=

# ─── AI ───────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:7001
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# XAI_API_KEY=
# XAI_MODEL=grok-3-mini-fast
AI_TIMEOUT_MS=30000
AI_FREE_MAX_REQUESTS_PER_DAY=10

# ─── Stripe Billing ──────────────────────────────────────────────────
# IMPORTANT: In production use live keys, not sk_test_*
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_PRICE_STUDENT=price_student_id
STRIPE_PRICE_PRO=price_pro_id
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard
STRIPE_CANCEL_URL=http://localhost:3000/dashboard

# ─── Admin ─────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com
ADMIN_USER_IDS=
ADMIN_MOBILES=

# ─── Feature Flags ────────────────────────────────────────────────────
RESUME_CREATION_RATE_LIMIT_DEFAULT=false
FORCE_DISABLE_RATE_LIMIT=true

# ─── PDF Export (Puppeteer) ───────────────────────────────────────────
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium-browser
