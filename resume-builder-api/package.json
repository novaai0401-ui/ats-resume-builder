{
  "name": "resume-builder-api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API service",
  "scripts": {
    "bootstrap:deps": "npm --prefix ../packages/resume-schemas ci && npm --prefix ../packages/resume-intelligence ci && npm --prefix ../packages/doc-extract ci",
    "build:deps": "npm --prefix ../packages/resume-schemas run build && npm --prefix ../packages/resume-intelligence run build && npm --prefix ../packages/doc-extract run build",
    "start": "nest start",
    "prestart:dev": "npm run bootstrap:deps && npm run build:deps",
    "start:dev": "nest start --watch",
    "prebuild": "npm run bootstrap:deps && npm run build:deps",
    "build": "nest build",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/passport": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "5.22.0",
    "@sparticuz/chromium": "^133.0.0",
    "@upstash/redis": "^1.36.3",
    "bcryptjs": "latest",
    "docx": "^9.5.0",
    "helmet": "^8.1.0",
    "mammoth": "^1.11.0",
    "nodemailer": "^8.0.4",
    "passport": "latest",
    "passport-jwt": "latest",
    "pdf-parse": "^2.4.5",
    "puppeteer-core": "^24.39.1",
    "razorpay": "^2.9.6",
    "doc-extract": "../packages/doc-extract",
    "reflect-metadata": "latest",
    "resume-builder-shared": "../resume-builder-shared",
    "resume-intelligence": "../packages/resume-intelligence",
    "resume-schemas": "../packages/resume-schemas",
    "rxjs": "latest",
    "stripe": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@nestjs/testing": "latest",
    "@types/bcryptjs": "latest",
    "@types/multer": "^2.0.0",
    "@types/node": "latest",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "latest",
    "prisma": "5.22.0",
    "supertest": "^7.1.4",
    "typescript": "latest"
  }
}
